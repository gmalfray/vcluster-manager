apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization

resources:
  - ../../../../../../lib/tenant-template/cert-manager

patches:
  - target:
      group: helm.toolkit.fluxcd.io
      version: v2
      kind: HelmRelease
      name: cert-manager
      namespace: flux-system
    patch: |
      - op: replace
        path: /metadata/namespace
        value: vcluster-{{.Name}}
      # Le HelmRepository jetstack est déplacé, juste en dessous, de
      # `cert-manager` vers ce namespace. Sans réécrire aussi la référence, le
      # HelmRelease continue de le chercher dans `cert-manager`, où il n'est
      # plus : « HelmRepository "jetstack" not found », et cert-manager n'est
      # jamais installé dans le vcluster — donc aucun certificat pour les
      # ingress du tenant.
      #
      # Le défaut ne se voit pas à la création : le vcluster démarre, la
      # Kustomization s'applique, seul un HelmRelease reste en échec dans un
      # namespace que personne ne regarde. Trouvé en inspectant les
      # réconciliations du cluster, pas par un test.
      #
      # Le HelmRelease cert-manager-webhook-gandi plus bas n'a pas besoin du
      # même traitement : son sourceRef ne porte pas de namespace, il résout
      # donc dans celui du HelmRelease, qui est déjà réécrit.
      - op: replace
        path: /spec/chart/spec/sourceRef/namespace
        value: vcluster-{{.Name}}
      - op: add
        path: /spec/kubeConfig
        value:
          secretRef:
            name: vc-vcluster-{{.Name}}-int
            key: config
  - target:
      group: source.toolkit.fluxcd.io
      version: v1
      kind: HelmRepository
      name: jetstack
      namespace: cert-manager
    patch: |
      - op: replace
        path: /metadata/namespace
        value: vcluster-{{.Name}}
  - target:
      group: helm.toolkit.fluxcd.io
      version: v2
      kind: HelmRelease
      name: cert-manager-webhook-gandi
      namespace: cert-manager
    patch: |
      - op: replace
        path: /metadata/namespace
        value: vcluster-{{.Name}}
      - op: add
        path: /spec/kubeConfig
        value:
          secretRef:
            name: vc-vcluster-{{.Name}}-int
            key: config
  - target:
      group: source.toolkit.fluxcd.io
      version: v1
      kind: HelmRepository
      name: cert-manager-webhook-gandi
      namespace: cert-manager
    patch: |
      - op: replace
        path: /metadata/namespace
        value: vcluster-{{.Name}}
