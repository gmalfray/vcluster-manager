apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: navlink-{{.Name}}
  namespace: vcluster-{{.Name}}
spec:
  dependsOn:
    - name: argocd-{{.Name}}
  interval: 5m
  sourceRef:
    kind: GitRepository
    name: flux-system
    namespace: flux-system
  # Chemin partagé par tous les vclusters : plus d'overlay kustomize par vcluster
  # à commiter. Ce qui variait (le libellé, l'URL) est substitué depuis le
  # ConfigMap que l'opérateur rend à partir du CR. Même patron que
  # cert-manager-config, qui pointait déjà sur ./lib.
  path: ./lib/tenant-template/argocd/navlink
  prune: true
  timeout: 5m
  postBuild:
    substituteFrom:
      - kind: ConfigMap
        name: cluster-vars
      - kind: ConfigMap
        name: vcluster-{{.Name}}-substitutions
  kubeConfig:
    secretRef:
      name: vc-vcluster-{{.Name}}-int
      key: config
